{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/artifacts/itoguruma/itoguruma.exe\" hook --agent claude-main --db \"$CLAUDE_PROJECT_DIR/data/messages.db\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/artifacts/itoguruma/itoguruma.exe\" hook --agent claude-main --db \"$CLAUDE_PROJECT_DIR/data/messages.db\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/artifacts/itoguruma/itoguruma.exe\" hook --agent claude-main --db \"$CLAUDE_PROJECT_DIR/data/messages.db\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
