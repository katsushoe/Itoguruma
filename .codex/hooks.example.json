{
  "description": "Check the Itoguruma inbox during the Codex lifecycle.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "itoguruma hook --project-inbox --consumer-agent codex",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& 'itoguruma' hook --project-inbox --consumer-agent codex\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "itoguruma hook --project-inbox --consumer-agent codex",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& 'itoguruma' hook --project-inbox --consumer-agent codex\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "itoguruma hook --project-inbox --consumer-agent codex",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& 'itoguruma' hook --project-inbox --consumer-agent codex\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
